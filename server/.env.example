# App
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
TRUST_PROXY=false

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=passdesk
DB_USER=admin
DB_PASSWORD=admin_password
DB_SSL=false
# Optional CA certificate content for DB TLS verification (supports \n)
DB_SSL_CA=
# Optional filesystem path to CA certificate (used when DB_SSL=true and DB_SSL_CA empty)
DB_SSL_CA_PATH=/app/cert/root.crt
# Sequelize pool tuning (API + workers)
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE_MS=60000
DB_POOL_IDLE_MS=20000
DB_POOL_EVICT_MS=5000
# Pool role overrides (optional, for separate worker/API deployments)
# DB_POOL_ROLE=api
# DB_POOL_MAX_API=20
# DB_POOL_MIN_API=2
# DB_POOL_ACQUIRE_MS_API=60000
# DB_POOL_IDLE_MS_API=20000
# DB_POOL_EVICT_MS_API=5000
# DB_POOL_MAX_WORKER=10
# DB_POOL_MIN_WORKER=1
# DB_POOL_ACQUIRE_MS_WORKER=60000
# DB_POOL_IDLE_MS_WORKER=20000
# DB_POOL_EVICT_MS_WORKER=5000

# Auth (min 32 chars each)
JWT_SECRET=replace_with_strong_secret_min_32_chars
JWT_EXPIRE=2h
JWT_REFRESH_SECRET=replace_with_other_strong_secret_min_32_chars
JWT_REFRESH_EXPIRE=7d
BCRYPT_ROUNDS=10

# Storage provider: cloudru | yandexs3 | yandexdisk
STORAGE_PROVIDER=cloudru

# Cloud.ru S3
CLOUDRU_S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
CLOUDRU_S3_REGION=ru1
CLOUDRU_S3_BUCKET_NAME=replace_bucket_name
CLOUDRU_S3_ACCESS_KEY_ID=replace_access_key_id
CLOUDRU_S3_SECRET_ACCESS_KEY=replace_secret_access_key
CLOUDRU_S3_BASE_PATH=
CLOUDRU_S3_KMS_KEY_ID=

# Generic S3 fallback (optional)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BASE_PATH=
S3_KMS_KEY_ID=

# Yandex S3 (optional)
YANDEX_S3_ENDPOINT=https://storage.yandexcloud.net
YANDEX_S3_REGION=ru-central1
YANDEX_S3_BUCKET_NAME=
YANDEX_S3_ACCESS_KEY_ID=
YANDEX_S3_SECRET_ACCESS_KEY=
YANDEX_S3_BASE_PATH=
YANDEX_S3_KMS_KEY_ID=

# Yandex Disk (optional)
YANDEX_DISK_TOKEN=
YANDEX_DISK_BASE_PATH=/PassDesk

# Uploads / notifications
MAX_FILE_SIZE=104857600
MAX_FILES_PER_REQUEST=100
EMAIL_WEBHOOK_URL=
OT_EMAIL_WEBHOOK_URL=

# Mobile employee access (OTP)
MOBILE_ACCESS_CODE_TTL_MINUTES=5
MOBILE_ACCESS_CODE_MAX_ATTEMPTS=5
MOBILE_ACCESS_SESSION_TTL_DAYS=30
MOBILE_ACCESS_SESSION_LIMIT=5
# Allowed delivery modes: sms, push, log, debug
MOBILE_ACCESS_DELIVERY_MODE=log
# Debug OTP in API response is allowed only in NODE_ENV=development
MOBILE_ACCESS_DEBUG_RETURN_CODE=false
MOBILE_ACCESS_SMS_WEBHOOK_URL=
MOBILE_ACCESS_SMS_WEBHOOK_TOKEN=
MOBILE_ACCESS_PUSH_WEBHOOK_URL=
MOBILE_ACCESS_PUSH_WEBHOOK_TOKEN=
# Quick QR (pre-release gate)
MOBILE_ACCESS_QUICK_QR_RELEASED=false

# Field-level encryption (employees)
FIELD_ENCRYPTION_ENABLED=true
APP_FIELD_ENCRYPTION_ACTIVE_KEY_VERSION=v1
APP_FIELD_ENCRYPTION_KEYS={"v1":"replace_with_base64_32_byte_key"}
APP_FIELD_HASH_PEPPER=replace_with_very_long_random_secret
# Full encryption mode: do not store plaintext for sensitive fields.
FIELD_ENCRYPTION_KEEP_LEGACY_DOC_PLAINTEXT=false
FIELD_ENCRYPTION_KEEP_LEGACY_PLAINTEXT=false

# File encryption for sensitive document scans
FILE_ENCRYPTION_ENABLED=true
# By default file encryption reuses APP_FIELD_ENCRYPTION_* keys.
# Optionally set dedicated keys:
# APP_FILE_ENCRYPTION_ACTIVE_KEY_VERSION=v1
# APP_FILE_ENCRYPTION_KEYS={"v1":"replace_with_base64_32_byte_key"}
# CSV list of document types that should be encrypted before S3 upload
FILE_ENCRYPTION_SENSITIVE_DOC_TYPES=passport,kig,patent_front,patent_back,application_scan
# Dedicated JWT secret for file proxy links (required, at least 32 chars)
FILE_PROXY_JWT_SECRET=replace_with_very_long_random_secret
# Migration fallback to JWT_SECRET (avoid enabling in production)
FILE_PROXY_ALLOW_LEGACY_JWT_SECRET=false
# Short-lived token TTL for proxy download links (seconds)
FILE_PROXY_TOKEN_TTL_SECONDS=300

# Telegram bot
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_LINK_CODE_TTL_MINUTES=10
TELEGRAM_EXPIRY_CHECK_INTERVAL_MS=3600000

# SKUD (Sigur)
SKUD_ENABLED=false
SKUD_PROVIDER=sigur
SKUD_SIGUR_BASE_URL=
SKUD_SIGUR_USERNAME=
SKUD_SIGUR_PASSWORD=
SKUD_SIGUR_TIMEOUT_MS=15000
SKUD_SIGUR_INSECURE_TLS=false
SKUD_WEBHOOK_BASIC_USER=
SKUD_WEBHOOK_BASIC_PASS=
SKUD_WEBHOOK_ALLOWED_IPS=
SKUD_QR_HMAC_SECRET=replace_with_strong_random_secret
SKUD_QR_PERSISTENT_TTL_SECONDS=3600
SKUD_QR_ONE_TIME_TTL_SECONDS=300
SKUD_SYNC_CONCURRENCY=2
SKUD_SYNC_RETRY_LIMIT=5
SKUD_EVENTS_PULL_INTERVAL_MS=60000
SKUD_EVENTS_PULL_WINDOW_MINUTES=60
SKUD_EVENTS_PULL_OVERLAP_MINUTES=2
SKUD_EVENTS_PULL_MAX_PAGES=5

# Redis (for SKUD queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 1C Sync
SYNC_1C_API_KEY=replace_with_strong_random_secret
SYNC_1C_USER_ID=replace_with_service_user_uuid
